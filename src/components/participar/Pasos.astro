---
/* «¿Cómo participar?» — «Frame 119» (550:1593) de «Desktop - 6»: el título
   en Header 1, las cuatro tarjetas de los pasos («Frame 116», 550:1595: 285
   × 412, a 20 entre sí) y «Agenda tu cita» (306 de ancho), con 66 entre una
   pieza y la siguiente.

   Cada tarjeta («Paso 1», 550:1596): fondo neutral/200, borde de 1 en
   neutral/300, radio 22.84 y 32 × 24 de relleno. Arriba, el símbolo de
   Elexa en lila al 40 % (235 × 265.6, de lado a lado del relleno) y encima
   el número (120/82 en brand/300), apoyado en el fondo de una caja de 262;
   24 más abajo, el paso en Header 4 (24/30) en ink/300.

   Lo de adentro se mide contra el ancho de la tarjeta (`--u` es un px de
   los 285 de Figma), así en pantallas más angostas la tarjeta se achica
   entera y el número no se sale; sólo el texto tiene un piso de 16. El
   diseño del teléfono todavía muestra los siete pasos de la versión
   anterior: hasta que se actualice, bajo 1024 las tarjetas van de a dos,
   de 285 como mucho.

   El número es decoración: la lista ordenada ya dice qué paso es cuál.
   El botón abre el Calendly de Luis, como el de «10 minutos con Luis» que
   viene justo debajo. */
import { CITA_LUIS_URL, esExterno } from '../../data/site';

interface Props {
  /** Distancia con lo de arriba en escritorio: 148 en /como-participar
      (desde el encabezado) y 192 en /karanis (desde la foto de la
      fachada). Entre 768 y 1240 es siempre 96. */
  separacion?: number;
  /** La misma en el teléfono: 61 en /como-participar, 64 en /karanis. */
  separacionMovil?: number;
}

const { separacion = 148, separacionMovil = 61 } = Astro.props;

const pasos = [
  'Conoce el proyecto y resuelve dudas',
  'Separa tu cupo desde 5 Millones',
  'Documentación y plan de pagos',
  'Firma el contrato y completa tu aporte',
];

const externo = esExterno(CITA_LUIS_URL) ? { target: '_blank', rel: 'noopener' } : {};
---

<section
  class="pasos contenedor"
  aria-labelledby="pasos-titulo"
  style={`--separacion:${separacion}px;--separacion-movil:${separacionMovil}px`}
>
  <h2 class="display t-h1" id="pasos-titulo">¿Cómo <span class="acento">participar?</span></h2>

  <ol class="pasos__lista" role="list">
    {
      pasos.map((paso, i) => (
        <li class="paso">
          <div class="paso__tarjeta">
            <div class="paso__cifra">
              <img
                class="paso__simbolo"
                src="/img/participar/simbolo-paso.svg"
                alt=""
                width="235"
                height="265.6"
                loading="lazy"
              />
              <span class="paso__numero display" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <p class="paso__texto display">{paso}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <a
    class="btn btn--primario pasos__boton"
    href={CITA_LUIS_URL ?? undefined}
    {...externo}
    data-pixel="Schedule"
    data-pixel-nombre="agendar_reunion"
  >
    Agenda tu cita
  </a>
</section>

<style>
  .pasos {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-xl);
    margin-top: var(--separacion-movil);
    color: var(--brand-500);
  }

  /* De a dos, nunca más anchas que las 285 del diseño: en una tablet dos
     columnas a lo ancho dejarían el número en 180. */
  .pasos__lista {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 285px));
    gap: 12px;
    width: 100%;
  }

  /* El <li> es el contenedor que miden las unidades de la tarjeta. */
  .paso {
    container-type: inline-size;
    display: flex;
  }

  .paso__tarjeta {
    --u: calc(100cqw / 285);
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: calc(24 * var(--u));
    overflow: clip;
    padding: calc(32 * var(--u)) calc(24 * var(--u));
    border: 1px solid var(--neutral-300);
    border-radius: calc(22.84 * var(--u));
    background: var(--neutral-200);
  }

  /* El símbolo y el número van juntos: si la tarjeta es más alta que su
     contenido (un paso de más renglones en la misma fila), se centran los
     dos y el número no se despega del símbolo. */
  .paso__cifra {
    position: relative;
    display: flex;
    align-items: flex-end;
    height: calc(262 * var(--u));
  }

  .paso__simbolo {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: auto;
    opacity: 0.4;
  }

  .paso__numero {
    position: relative;
    color: var(--brand-300);
    font-size: calc(120 * var(--u));
    line-height: calc(82 * var(--u));
  }

  .paso__texto {
    margin: 0;
    color: var(--ink-300);
    font-size: max(16px, calc(24 * var(--u)));
    line-height: 1.25;
  }

  .pasos__boton {
    width: 306px;
    max-width: 100%;
  }

  /* En el teléfono el botón va a lo ancho, como los demás de la página. */
  @media (max-width: 767px) {
    .pasos__boton {
      align-self: stretch;
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .pasos {
      gap: var(--space-2xl);
      margin-top: 96px;
    }

    .pasos__lista {
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .pasos__lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* El encabezado termina en y = 369 y el título arranca en 517; título,
     tarjetas y botón, a 66. Con 1200 de contenido las tarjetas miden 285. */
  @media (min-width: 1240px) {
    .pasos {
      gap: 66px;
      margin-top: var(--separacion);
    }
  }
</style>
