---
/* Pixel de Meta (Facebook e Instagram). Base.astro lo pone al principio del
   <body>, así queda en todas las páginas.

   Qué se reporta (acordado con marketing el 27 oct 2026):

     Todas las páginas         PageView            sola, en cada visita
     /proyectos                ViewContent         content_category: proyectos
     /como-participar          IntentSignal        content_name: como_participar
                               (personalizado)
     «Ver proyecto»            ViewContent         content_name: Proyecto_E,
                                                   Florentino…; content_category:
                                                   proyectos
     «Hablemos» (barra)        Lead                hablemos_header,
                                                   content_category: whatsapp
     WhatsApp del pie          Contact             whatsapp_footer
     WhatsApp del equipo       Contact             whatsapp_equipo
     «Agenda tu cita»          Schedule            agendar_reunion
     Radiografía: datos        Lead                radiografia_financiera,
       de contacto enviados                        content_category: lead_form
     Radiografía: resultado    CompleteRegistration  registro_completado

   Lead es el evento con el que se optimizan las campañas, así que sale sólo
   en dos lugares: «Hablemos», que abre la conversación por WhatsApp (decisión
   de marketing del 27 oct 2026), y la radiografía cuando la persona deja sus
   datos. `content_category` los separa en el reporte (whatsapp / lead_form).
   «Hablemos» sólo se ve en escritorio (1240 px o más); en el celular, la barra
   muestra «Agenda tu cita».

   · Los eventos de las páginas llegan por la prop `evento` (ver Base.astro y
     src/lib/pixel.ts).
   · Los botones se marcan en el HTML con `data-pixel` (el evento),
     `data-pixel-nombre` y, si aplica, `data-pixel-categoria`. Un solo
     escucha en el documento los reporta, así sirve también para los que
     aparecen después (las tarjetas del carrusel, la radiografía).
   · Un enlace de WhatsApp sin marca cuenta como Contact «whatsapp», para que
     uno nuevo no se escape.
   · El formulario reporta desde su propio código (Radiografia.tsx).

   Cada evento sale una vez por página: dos clics en el mismo botón son una
   sola intención.

   Va en el <body> y no en el <head> porque el <noscript> lleva una imagen,
   y una imagen dentro del <head> lo cierra antes de tiempo. El script carga
   async, así que no se nota.

   Sólo corre en elexa.com.co: las pruebas en local y las vistas previas de
   Vercel no cuentan. El ID está en src/data/site.ts. */
import { META_PIXEL_ID } from '../data/site';
import type { EventoPagina } from '../lib/pixel';

interface Props {
  evento?: EventoPagina;
}

const { evento = null } = Astro.props;
---

{
  META_PIXEL_ID && (
    <Fragment>
      <script is:inline define:vars={{ pixelId: META_PIXEL_ID, eventoPagina: evento }}>
        if (/(^|\.)elexa\.com\.co$/.test(location.hostname)) {
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};
          if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
          n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t,s)}(window, document,'script',
          'https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pixelId);
          fbq('track', 'PageView');

          var enviados = {};
          function reportar(tipo, nombre, parametros) {
            var clave = nombre + '|' + (parametros.content_name || '');
            if (enviados[clave]) return;
            enviados[clave] = true;
            fbq(tipo, nombre, parametros);
          }

          if (eventoPagina) {
            reportar(eventoPagina.propio ? 'trackCustom' : 'track', eventoPagina.evento, eventoPagina.parametros);
          }

          var whatsapp = /^(wa\.me|wa\.link|(api\.|web\.)?whatsapp\.com)$/;
          document.addEventListener('click', function (clic) {
            var enlace = clic.target.closest && clic.target.closest('a[href]');
            if (!enlace) return;
            var marca = enlace.dataset;
            if (marca.pixel) {
              var parametros = { content_name: marca.pixelNombre };
              if (marca.pixelCategoria) parametros.content_category = marca.pixelCategoria;
              reportar('track', marca.pixel, parametros);
            } else if (whatsapp.test(enlace.hostname)) {
              reportar('track', 'Contact', { content_name: 'whatsapp' });
            }
          });
        }
      </script>

      {/* Para quien navega sin JavaScript: sólo cuenta la visita. */}
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${META_PIXEL_ID}&ev=PageView&noscript=1`}
        />
      </noscript>
    </Fragment>
  )
}
