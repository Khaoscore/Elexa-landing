---
/* Ficha de un espacio — parte del frame "Desktop - 5" (48:1862), rearmado
   para que no queden huecos (nov 2026).

   La URL es /espacios/{slug}; el espacio sale de la tabla `propiedades` (ver
   src/lib/espacios.ts). Si ya no está en la hoja la página responde 404; si
   cambió de nombre, redirige a su URL nueva.

   · Cabecera: ruta «En alquiler / barrio» (Text button morado) y el nombre
     en Header 2, a todo el ancho. Sin el encabezado grande de /espacios
     («Espacios disponibles para alquilar»): en la ficha empujaba el espacio
     media pantalla hacia abajo, y «En alquiler» ya lleva a la lista.
   · Dos columnas en escritorio (1240 o más):
     — a la izquierda la foto con el precio en la muesca (FotosEspacio),
       «Descripción» (el texto de «Características y atractivos», un párrafo
       por renglón de la celda) y «Ubicación» (dirección, «Cómo llegar» y el
       mapa en el punto exacto; sin coordenadas no sale);
     — a la derecha una tarjeta gris que acompaña al bajar (sticky): los
       datos con su círculo magenta (barrio, área, disponibilidad y
       dirección, ésta con «Ver en el mapa»), «Me interesa este espacio»
       (WhatsApp con el nombre del espacio ya escrito), «Ver más espacios»
       y debajo «Compartir» y «Fotos y documentos» (CompartirYDescargar).
   · Al pie, «Otros espacios disponibles»: dos tarjetas de /espacios, primero
     las del mismo barrio.

   En el teléfono y la tableta, todo en una columna y en ese orden: foto,
   tarjeta, descripción, ubicación y otros espacios.

   El contenido y los estilos están en FichaEspacio.astro, que comparte con
   la versión sin marca (/comerciales/{slug}). */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import FichaEspacio from '../../components/espacios/FichaEspacio.astro';
import { getEspacio } from '../../lib/espacios';
import { origenesDe } from '../../lib/origenes';
import { ESPACIOS_URL, SITE_URL, whatsappAlquiler } from '../../data/site';

const { slug = '' } = Astro.params;
const encontrado = await getEspacio(slug);

if (encontrado && !encontrado.exacto) {
  return Astro.redirect(`${ESPACIOS_URL}/${encontrado.espacio.slug}`, 301);
}

const espacio = encontrado?.espacio ?? null;
const otros = encontrado?.otros ?? [];

if (!espacio) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

const valor = espacio ? [espacio.precio, espacio.precioNota].filter(Boolean).join(' ') : '';
const descripcion = espacio
  ? [
      `${espacio.nombre}${espacio.barrio ? `, ${espacio.barrio}` : ''}.`,
      espacio.direccion && `${espacio.direccion}.`,
      espacio.area && `${espacio.area}.`,
      espacio.disponibilidad && `${espacio.disponibilidad}.`,
      valor && `${valor}.`,
      'Espacio comercial en alquiler en un proyecto de Elexa.',
    ]
      .filter(Boolean)
      .join(' ')
  : 'El espacio que busca ya no está disponible.';

/* La línea de alquiler, con el mensaje ya escrito: quien atiende el WhatsApp
   sabe de qué espacio le hablan, con el enlace a la ficha. */
const meInteresa = espacio
  ? whatsappAlquiler(
      `Hola, me interesa el espacio «${espacio.nombre}»${espacio.barrio ? ` en ${espacio.barrio}` : ''}: ${SITE_URL}${ESPACIOS_URL}/${espacio.slug}`,
    )
  : '';
---

<Base
  title={espacio ? `${espacio.nombre} — Espacios en alquiler — Elexa` : 'Espacio no encontrado — Elexa'}
  description={descripcion}
  path={`${ESPACIOS_URL}/${espacio?.slug ?? slug}`}
  imagen={espacio?.fotos[0]?.jpeg}
  conectar={origenesDe([espacio?.fotos[0]?.src])}
  separacionPie={144}
  separacionPieMovil={61}
>
  {
    espacio ? (
      <FichaEspacio
        espacio={espacio}
        otros={otros}
        base={ESPACIOS_URL}
        url={`${SITE_URL}${ESPACIOS_URL}/${espacio.slug}`}
        meInteresa={meInteresa}
      />
    ) : (
      <section class="no-encontrado contenedor">
        <h1 class="display t-h2">Este espacio ya no está disponible</h1>
        <p>Puede que ya se haya alquilado. Mire los que tenemos abiertos ahora.</p>
        <a class="btn btn--primario" href={ESPACIOS_URL}>
          Ver espacios disponibles
        </a>
      </section>
    )
  }
</Base>

<style>
  .no-encontrado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-top: 64px;
    color: var(--brand-500);
    text-align: center;
  }
</style>
