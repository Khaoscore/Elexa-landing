---
/* La ventana de «Compartir»: la usan la ficha de un espacio
   (CompartirYDescargar.astro), la barra y el pie de /comerciales, que
   comparten la lista con todos los espacios (COMPARTIR_LISTA en
   src/data/comerciales.ts), y la barra de la selección de /comerciales
   (BarraSeleccion.astro).

   El botón que la abre lo pone quien la usa, en el slot, con
   data-abrir-compartir (así lleva los estilos de su lugar). La envoltura es
   display: contents: el botón se acomoda como si estuviera suelto en su fila.

   · En el teléfono abre el menú de compartir del sistema (WhatsApp,
     Instagram, mensajes…). En el computador, o si el navegador no lo tiene,
     abre la ventana con WhatsApp, Facebook, X, Telegram y «Copiar enlace».
   · Lo que se comparte se lee de los data- de la envoltura al momento de
     abrir: quien lo cambie después (la selección, que cambia con cada
     espacio que se agrega) sólo tiene que actualizar data-url, data-texto y
     data-detalle. Los enlaces de las redes se rehacen ahí mismo
     (src/lib/compartir.ts).
   · Pixel de Meta: un evento propio (`evento`), que no cuenta como contacto
     (ver MetaPixel.astro). Los enlaces de la ventana se marcan con
     data-pixel; el menú del sistema y «Copiar enlace» son botones y reportan
     desde el script. Cada lugar tiene su evento: el pixel cuenta una vez por
     página cada evento y canal, y en la ficha de /comerciales están varios.

   La ventana va en la capa de arriba de todo, encima del cursor de Elexa:
   con data-cursor="nativo" adentro vuelve el del sistema (como el visor de
   fotos). */
import { REDES, enlaceDe } from '../lib/compartir';

interface Props {
  /** Lo que se comparte, debajo del título de la ventana. */
  titulo: string;
  /** Un dato más al lado del título (el barrio). Opcional. */
  detalle?: string;
  /** La dirección pública que se comparte, con dominio. */
  url: string;
  /** El mensaje que acompaña al enlace (sin el enlace). */
  texto: string;
  /** El evento personalizado del pixel: CompartirEspacio, CompartirListado,
      CompartirSeleccion. */
  evento: string;
  /** content_category del pixel: espacios o comerciales. */
  categoria: string;
}

const { titulo, detalle = '', url, texto, evento, categoria } = Astro.props;

// En la ficha de /comerciales hay varias ventanas: cada título con su id.
const tituloId = `compartir-titulo-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class="compartir-raiz"
  data-compartir
  data-url={url}
  data-titulo={titulo}
  data-detalle={detalle}
  data-texto={texto}
  data-evento={evento}
  data-categoria={categoria}
>
  <slot />

  <dialog class="compartir" aria-labelledby={tituloId} data-cursor="nativo">
    <div class="compartir__caja">
      <div class="compartir__cabecera">
        <p class="compartir__titulo" id={tituloId}>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="currentColor"
              d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
            ></path>
          </svg>
          Compartir
        </p>
        <button type="button" class="compartir__cerrar" data-cerrar aria-label="Cerrar">
          <img src="/img/iconos/close.svg" alt="" width="24" height="24" />
        </button>
      </div>

      <p class="compartir__que" data-que>{[titulo, detalle].filter(Boolean).join(' · ')}</p>

      <ul class="compartir__redes" role="list">
        {
          REDES.map(({ red, nombre }) => (
            <li>
              <a
                class="compartir__red"
                href={enlaceDe(red, url, texto)}
                target="_blank"
                rel="noopener"
                data-red={red}
                data-pixel={evento}
                data-pixel-propio
                data-pixel-nombre={red}
                data-pixel-categoria={categoria}
              >
                <span class="compartir__icono" aria-hidden="true">
                  {red === 'whatsapp' && <img src="/img/iconos/whatsapp.svg" alt="" width="24" height="24" />}
                  {red === 'facebook' && (
                    <svg viewBox="0 0 24 24" width="24" height="24">
                      <path
                        fill="currentColor"
                        d="M14 8h3V4h-3c-2.76 0-5 2.24-5 5v2H7v4h2v9h4v-9h3l1-4h-4V9c0-.55.45-1 1-1z"
                      />
                    </svg>
                  )}
                  {red === 'x' && (
                    <svg viewBox="0 0 24 24" width="20" height="20">
                      <path
                        fill="currentColor"
                        d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
                      />
                    </svg>
                  )}
                  {red === 'telegram' && (
                    <svg viewBox="0 0 24 24" width="24" height="24">
                      <path
                        fill="currentColor"
                        d="M21.94 4.3 18.7 19.6c-.24 1.08-.88 1.35-1.79.84l-4.94-3.64-2.38 2.29c-.26.26-.48.48-.99.48l.35-5.02 9.14-8.26c.4-.35-.09-.55-.62-.2L6.17 13.2l-4.87-1.52c-1.06-.33-1.08-1.06.22-1.57L20.55 2.77c.88-.33 1.65.2 1.39 1.53z"
                      />
                    </svg>
                  )}
                </span>
                {nombre}
              </a>
            </li>
          ))
        }
        <li>
          <button type="button" class="compartir__red" data-copiar>
            <span class="compartir__icono" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="24" height="24">
                <path
                  fill="currentColor"
                  d="M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z"
                />
              </svg>
            </span>
            <span data-copiar-texto>Copiar enlace</span>
          </button>
        </li>
      </ul>
      <p class="compartir__aviso" role="status" aria-live="polite" data-aviso></p>
    </div>
  </dialog>
</div>

<script>
  import { enlaceDe, type Red } from '../lib/compartir';
  import { copiar, reportarPropio } from '../lib/navegador';

  /* En el teléfono, el menú del sistema; en el computador, la ventana (en
     Windows y Mac el del sistema es una ventanita ajena al sitio). */
  const tactil = window.matchMedia('(pointer: coarse)');

  for (const raiz of document.querySelectorAll<HTMLElement>('[data-compartir]')) {
    const abrir = raiz.querySelector<HTMLButtonElement>('[data-abrir-compartir]');
    const ventana = raiz.querySelector<HTMLDialogElement>('.compartir');
    if (!abrir || !ventana) continue;

    const que = ventana.querySelector<HTMLElement>('[data-que]')!;
    const botonCopiar = ventana.querySelector<HTMLButtonElement>('[data-copiar]')!;
    const copiarTexto = ventana.querySelector<HTMLElement>('[data-copiar-texto]')!;
    const aviso = ventana.querySelector<HTMLElement>('[data-aviso]')!;
    let vuelta = 0;

    /* Lo que se comparte, tal como está ahora en la envoltura. */
    const actual = () => {
      const { url = location.href, titulo = document.title, detalle = '', texto = '' } = raiz.dataset;
      return {
        url,
        titulo,
        detalle,
        texto,
        evento: raiz.dataset.evento ?? 'CompartirEspacio',
        categoria: raiz.dataset.categoria ?? 'espacios',
      };
    };

    abrir.addEventListener('click', async () => {
      const { url, titulo, detalle, texto, evento, categoria } = actual();
      if (tactil.matches && typeof navigator.share === 'function') {
        try {
          await navigator.share({ title: titulo, text: texto, url });
          reportarPropio(evento, 'menu_sistema', categoria);
          return;
        } catch (error) {
          // Si la persona lo cerró, nada más; si falló, se abre la ventana.
          if ((error as DOMException).name === 'AbortError') return;
        }
      }
      que.textContent = [titulo, detalle].filter(Boolean).join(' · ');
      for (const enlace of ventana.querySelectorAll<HTMLAnchorElement>('a[data-red]')) {
        enlace.href = enlaceDe(enlace.dataset.red as Red, url, texto);
      }
      aviso.textContent = '';
      ventana.showModal();
    });

    ventana.querySelector('[data-cerrar]')?.addEventListener('click', () => ventana.close());

    // Un clic fuera de la caja (en el fondo oscuro) también cierra.
    ventana.addEventListener('click', (clic) => {
      if (clic.target === ventana) ventana.close();
    });

    // Al elegir una red, la ventana se cierra: la red abre en otra pestaña.
    for (const red of ventana.querySelectorAll('a.compartir__red')) {
      red.addEventListener('click', () => ventana.close());
    }

    botonCopiar.addEventListener('click', async () => {
      const { url, evento, categoria } = actual();
      const ok = await copiar(url);
      if (ok) reportarPropio(evento, 'copiar_enlace', categoria);
      copiarTexto.textContent = ok ? '¡Copiado!' : 'Copiar enlace';
      aviso.textContent = ok ? 'Enlace copiado.' : `Copia el enlace a mano: ${url}`;
      clearTimeout(vuelta);
      vuelta = window.setTimeout(() => (copiarTexto.textContent = 'Copiar enlace'), 2000);
    });
  }
</script>

<style>
  .compartir-raiz {
    display: contents;
  }

  /* ---------- La ventana ---------- */
  .compartir {
    width: min(440px, 100% - 32px);
    max-width: none;
    padding: 0;
    border: 0;
    border-radius: var(--radius-panel);
    background: var(--neutral-100);
    color: var(--brand-500);
    box-shadow: 0 24px 64px rgba(15, 19, 22, 0.24);
  }
  .compartir::backdrop {
    background: rgba(29, 11, 48, 0.55);
  }
  .compartir[open] {
    animation: compartir-entra 0.2s ease;
  }
  @keyframes compartir-entra {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .compartir__caja {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
  }

  .compartir__cabecera {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .compartir__titulo {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 28px;
  }
  .compartir__titulo svg {
    color: var(--brand-300);
  }

  .compartir__cerrar {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -8px -8px -8px 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: transparent;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .compartir__cerrar:hover {
    background: var(--neutral-200);
  }

  .compartir__que {
    margin-top: -8px;
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-300);
  }

  .compartir__redes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Los círculos son los de los datos de la ficha (magenta, ícono blanco). */
  .compartir__red {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    padding: 4px 0;
    border: 0;
    border-radius: var(--radius-card);
    background: none;
    font-family: var(--font-body);
    font-size: 13px;
    line-height: 16px;
    color: var(--ink-300);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
  }

  .compartir__icono {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-full);
    background: var(--accent-300);
    color: var(--neutral-100);
    transition: background-color 0.2s ease;
  }
  .compartir__red:hover .compartir__icono {
    background: var(--accent-400);
  }
  .compartir__red:focus-visible {
    outline: 2px solid var(--brand-300);
    outline-offset: 2px;
  }

  .compartir__aviso {
    font-size: 14px;
    line-height: 20px;
    color: var(--ink-300);
    overflow-wrap: anywhere;
  }
  .compartir__aviso:empty {
    display: none;
  }

  /* Teléfono angosto (si el navegador no tiene el menú del sistema): las
     cinco no caben en una fila sin que los nombres se monten; van tres y
     dos, centradas. */
  @media (max-width: 419px) {
    .compartir__caja {
      padding: 20px 16px;
    }
    .compartir__redes {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: var(--space-md);
    }
    .compartir__redes li {
      grid-column: span 2;
    }
    .compartir__redes li:nth-child(4) {
      grid-column: 2 / span 2;
    }
  }
</style>
