---
/* Ficha de un espacio — parte del frame "Desktop - 5" (48:1862), rearmado
   para que no queden huecos (nov 2026).

   La URL es /espacios/{slug}; el espacio sale de la tabla `propiedades` (ver
   src/lib/espacios.ts). Si ya no está en la hoja la página responde 404; si
   cambió de nombre, redirige a su URL nueva.

   · Cabecera: ruta «En alquiler / barrio» (Text button morado) y el nombre
     en Header 2, a todo el ancho. Sin el encabezado grande de /espacios
     («Espacios disponibles para alquilar»): en la ficha empujaba el espacio
     media pantalla hacia abajo, y «En alquiler» ya lleva a la lista.
   · Dos columnas en escritorio (1240 o más):
     — a la izquierda la foto con el precio en la muesca (FotosEspacio),
       «Descripción» (el texto de «Características y atractivos», un párrafo
       por renglón de la celda) y «Ubicación» (dirección, «Cómo llegar» y el
       mapa en el punto exacto; sin coordenadas no sale);
     — a la derecha una tarjeta gris que acompaña al bajar (sticky): los
       datos con su círculo magenta (barrio, área, disponibilidad y
       dirección, ésta con «Ver en el mapa»), «Me interesa este espacio»
       (WhatsApp con el nombre del espacio ya escrito) y «Ver más espacios».
   · Al pie, «Otros espacios disponibles»: dos tarjetas de /espacios, primero
     las del mismo barrio.

   En el teléfono y la tableta, todo en una columna y en ese orden: foto,
   tarjeta, descripción, ubicación y otros espacios. */
export const prerender = false;

import Base from '../../layouts/Base.astro';
import FotosEspacio from '../../components/espacios/FotosEspacio.astro';
import MapaEspacio from '../../components/espacios/MapaEspacio.astro';
import TarjetaEspacio from '../../components/espacios/TarjetaEspacio.astro';
import { ANCLA_MAPA, comoLlegar, getEspacio } from '../../lib/espacios';
import { origenesDe } from '../../lib/origenes';
import { ESPACIOS_URL, SITE_URL, whatsappConMensaje } from '../../data/site';

const { slug = '' } = Astro.params;
const encontrado = await getEspacio(slug);

if (encontrado && !encontrado.exacto) {
  return Astro.redirect(`${ESPACIOS_URL}/${encontrado.espacio.slug}`, 301);
}

const espacio = encontrado?.espacio ?? null;
const otros = encontrado?.otros ?? [];

if (!espacio) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

const valor = espacio ? [espacio.precio, espacio.precioNota].filter(Boolean).join(' ') : '';
const descripcion = espacio
  ? [
      `${espacio.nombre}${espacio.barrio ? `, ${espacio.barrio}` : ''}.`,
      espacio.direccion && `${espacio.direccion}.`,
      espacio.area && `${espacio.area}.`,
      espacio.disponibilidad && `${espacio.disponibilidad}.`,
      valor && `${valor}.`,
      'Espacio comercial en alquiler en un proyecto de Elexa.',
    ]
      .filter(Boolean)
      .join(' ')
  : 'El espacio que busca ya no está disponible.';

/* El mensaje ya escrito: quien atiende el WhatsApp sabe de qué espacio le
   hablan, con el enlace a la ficha. */
const meInteresa = espacio
  ? whatsappConMensaje(
      `Hola, me interesa el espacio «${espacio.nombre}»${espacio.barrio ? ` en ${espacio.barrio}` : ''}: ${SITE_URL}${ESPACIOS_URL}/${espacio.slug}`,
    )
  : '';
---

<Base
  title={espacio ? `${espacio.nombre} — Espacios en alquiler — Elexa` : 'Espacio no encontrado — Elexa'}
  description={descripcion}
  path={`${ESPACIOS_URL}/${espacio?.slug ?? slug}`}
  imagen={espacio?.fotos[0]?.jpeg}
  conectar={origenesDe([espacio?.fotos[0]?.src])}
  separacionPie={144}
  separacionPieMovil={61}
>
  {
    espacio ? (
      <>
        <article class="ficha contenedor">
          <header class="ficha__cabecera">
            <nav class="ficha__ruta" aria-label="Ruta">
              <a href={ESPACIOS_URL}>En alquiler</a>
              {espacio.barrio && (
                <>
                  <span aria-hidden="true">/</span>
                  <span>{espacio.barrio}</span>
                </>
              )}
            </nav>
            <h1 class:list={['display t-h2', { 'ficha__nombre-largo': espacio.nombre.length > 32 }]}>{espacio.nombre}</h1>
          </header>

          <div class="ficha__cuerpo">
            <div class="ficha__fotos">
              <FotosEspacio espacio={espacio} />
            </div>

            <aside class="ficha__lateral" aria-label="Datos del espacio">
              <div class="ficha__resumen">
                {espacio.caracteristicas.length > 0 && (
                  <ul class="ficha__datos" role="list">
                    {espacio.caracteristicas.map((c) => (
                      <li>
                        <span class="ficha__icono" aria-hidden="true">
                          <img src={`/img/iconos/${c.icono}.svg`} alt="" width="26" height="26" />
                        </span>
                        <span class="ficha__dato">
                          <span class="ficha__etiqueta">{c.etiqueta}</span>
                          <span class="ficha__valor display">{c.texto}</span>
                          {c.enlace && (
                            <a class="ficha__enlace" href={c.enlace.href}>
                              {c.enlace.texto}
                            </a>
                          )}
                        </span>
                      </li>
                    ))}
                  </ul>
                )}

                <div class="ficha__acciones">
                  <a
                    class="btn btn--primario"
                    href={meInteresa}
                    target="_blank"
                    rel="noopener"
                    data-pixel="Contact"
                    data-pixel-nombre="whatsapp_espacio"
                    data-pixel-categoria="espacios"
                  >
                    <img src="/img/iconos/whatsapp.svg" alt="" width="20" height="20" />
                    Me interesa este espacio
                  </a>
                  <a class="btn btn--borde" href={ESPACIOS_URL}>
                    Ver más espacios
                  </a>
                </div>
              </div>
            </aside>

            {espacio.descripcion.length > 0 && (
              <section class="ficha__seccion ficha__descripcion" aria-labelledby="titulo-descripcion">
                <h2 id="titulo-descripcion" class="display t-h3">
                  Descripción
                </h2>
                <div class="ficha__texto">
                  {espacio.descripcion.map((parrafo) => (
                    <p>{parrafo}</p>
                  ))}
                </div>
              </section>
            )}

            {espacio.ubicacion && (
              <section class="ficha__seccion ficha__ubicacion" id={ANCLA_MAPA} aria-labelledby="titulo-ubicacion">
                <div class="ficha__seccion-cabecera">
                  <div>
                    <h2 id="titulo-ubicacion" class="display t-h3">
                      Ubicación
                    </h2>
                    {(espacio.direccion || espacio.barrio) && (
                      <p class="ficha__direccion">{[espacio.direccion, espacio.barrio].filter(Boolean).join(' · ')}</p>
                    )}
                  </div>
                  <a class="btn btn--borde ficha__como-llegar" href={comoLlegar(espacio.ubicacion)} target="_blank" rel="noopener">
                    Cómo llegar
                  </a>
                </div>
                <MapaEspacio ubicacion={espacio.ubicacion} nombre={espacio.nombre} />
              </section>
            )}
          </div>
        </article>

        {otros.length > 0 && (
          <section class="otros contenedor" aria-labelledby="titulo-otros">
            <div class="otros__cabecera">
              <h2 id="titulo-otros" class="display t-h3">
                Otros espacios disponibles
              </h2>
              <a class="ficha__enlace" href={ESPACIOS_URL}>
                Ver todos
              </a>
            </div>
            <ul class="otros__lista" role="list">
              {otros.map((otro) => (
                <li>
                  <TarjetaEspacio espacio={otro} />
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    ) : (
      <section class="no-encontrado contenedor">
        <h1 class="display t-h2">Este espacio ya no está disponible</h1>
        <p>Puede que ya se haya alquilado. Mire los que tenemos abiertos ahora.</p>
        <a class="btn btn--primario" href={ESPACIOS_URL}>
          Ver espacios disponibles
        </a>
      </section>
    )
  }
</Base>

<style>
  .ficha {
    margin-top: 40px;
    color: var(--brand-500);
  }

  /* ---------- Cabecera ---------- */
  .ficha__cabecera {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .ficha__ruta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 12px;
    font-weight: 700;
    font-size: 20px;
    line-height: 24px;
    color: var(--brand-300);
  }
  .ficha__ruta a {
    text-decoration: none;
  }
  .ficha__ruta a:hover {
    text-decoration: underline;
  }

  /* ---------- Cuerpo ----------
     Una columna; en escritorio, la grilla de dos (ver abajo). */
  .ficha__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    margin-top: 32px;
  }

  /* ---------- Tarjeta de datos ---------- */
  .ficha__resumen {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding: 28px 24px;
    border-radius: var(--radius-panel);
    background: var(--neutral-200);
  }

  /* En la tableta la tarjeta es ancha: los datos van de a dos. */
  .ficha__datos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 20px 24px;
  }

  .ficha__datos li {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .ficha__icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: var(--accent-300);
  }

  .ficha__dato {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .ficha__etiqueta {
    font-size: 14px;
    line-height: 18px;
    color: var(--ink-300);
  }

  .ficha__valor {
    font-size: 20px;
    line-height: 24px;
    overflow-wrap: anywhere;
  }

  .ficha__enlace {
    align-self: flex-start;
    margin-top: 2px;
    font-weight: 700;
    font-size: 16px;
    line-height: 20px;
    color: var(--brand-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ficha__enlace:hover {
    color: var(--brand-300-hover);
  }

  .ficha__acciones {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding-top: 28px;
    border-top: 1px solid var(--neutral-300);
  }
  .ficha__acciones .btn {
    width: 100%;
  }

  /* ---------- Descripción y Ubicación ---------- */
  .ficha__seccion {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 16px;
    /* «Ver en el mapa» salta acá: que el menú flotante no tape el título. */
    scroll-margin-top: 124px;
  }

  .ficha__texto {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    color: var(--ink-300);
    font-size: 16px;
    line-height: 24px;
  }

  .ficha__seccion-cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md) var(--space-lg);
  }

  .ficha__seccion-cabecera > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ficha__direccion {
    font-weight: 700;
    font-size: 16px;
    line-height: 22px;
    color: var(--ink-300);
  }

  .ficha__como-llegar {
    flex: none;
  }

  /* ---------- Otros espacios ---------- */
  .otros {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 72px;
    color: var(--brand-500);
  }

  .otros__cabecera {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
  }

  .otros__lista {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px 20px;
  }

  .no-encontrado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-top: 64px;
    color: var(--brand-500);
    text-align: center;
  }

  /* ---------- Teléfono ---------- */
  @media (max-width: 767px) {
    .ficha {
      margin-top: 32px;
    }

    .ficha__cabecera h1 {
      font-size: min(48px, 12.3vw);
      line-height: 1.0834;
    }

    /* Con los nombres largos de la hoja el Header 1 ocupa cinco renglones y
       deja la foto fuera de la pantalla: bajan a Mobile/Header 2 (30/34). */
    .ficha__cabecera h1.ficha__nombre-largo {
      font-size: 30px;
      line-height: 34px;
    }

    .ficha__cuerpo {
      margin-top: 24px;
    }

    .ficha__resumen {
      padding: 24px 20px;
    }

    .ficha__como-llegar {
      width: 100%;
    }

    .otros {
      margin-top: 56px;
    }
  }

  @media (min-width: 768px) {
    .ficha__texto {
      font-size: 18px;
      line-height: 28px;
    }

    .ficha__direccion {
      font-size: 18px;
      line-height: 24px;
    }

    .otros__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Escritorio: dos columnas ----------
     La foto a 793 como en el diseño; a su lado la tarjeta, que acompaña al
     bajar por la descripción y el mapa (sticky, debajo del menú flotante). */
  @media (min-width: 1240px) {
    .ficha {
      margin-top: 56px;
    }

    .ficha__cuerpo {
      grid-template-columns: 793px minmax(0, 1fr);
      grid-template-areas:
        'fotos lateral'
        'descripcion lateral'
        'ubicacion lateral';
      align-items: start;
      gap: 56px 40px;
      margin-top: 40px;
    }

    .ficha__fotos {
      grid-area: fotos;
    }
    .ficha__descripcion {
      grid-area: descripcion;
    }
    .ficha__ubicacion {
      grid-area: ubicacion;
    }

    .ficha__lateral {
      position: sticky;
      top: 124px;
      grid-area: lateral;
    }

    .ficha__seccion {
      margin-top: 0;
    }

    .ficha__resumen {
      padding: 32px 28px;
    }

    .otros {
      margin-top: 96px;
    }
  }
</style>
