---
/* «Nuestro equipo» — título «Frame 58» (48:1261) y la grilla de tarjetas
   (48:1268, 48:1350, 48:1366, 48:1382): tres columnas de 387 con 20 entre
   columnas y 56 entre filas. El nombre y el cargo van a 27 del borde
   izquierdo y a 394 del de arriba, con sombra para leerse sobre la foto.

   En el teléfono (título «Frame 58», 303:4761; tarjetas «Frame 59»,
   303:4764) el título baja a Mobile/Header 1. El diseño pone las tarjetas
   de a una, pero el cliente las pidió de a dos: a esa medida el nombre y el
   cargo achicados con la tarjeta no se leerían, así que tienen un mínimo y
   se apoyan desde abajo, para que un cargo de dos líneas crezca hacia
   arriba y no se salga de la foto.

   Al pasar el mouse por encima («Frame 66») la tarjeta se tiñe de morado
   con la misma forma de la foto —la capa usa la foto de máscara— y en el
   centro sale el correo y el teléfono (que abre su WhatsApp), o en los
   aliados el logo de su empresa. En el teléfono, la de contacto sale al
   tocarla (la tarjeta es enfocable y se muestra mientras tenga el foco); la
   del aliado es un enlace a su sitio y el toque lo abre.

   Con el mouse, además, la tarjeta tiene el efecto «cromo» (ver el script):
   se alza, se inclina hacia el puntero y una luz blanca lo sigue.

   Los datos están en src/data/equipo.ts. */
import { equipo, type Empresa } from '../../data/equipo';

/* Como en la banda de logos: a igual alto los anchos pesan más, así que el
   alto baja con la proporción ^ 0,4. Es el alto en la tarjeta de 387. */
const altoLogo = ({ ancho, alto }: Empresa['logo']) => Math.round(110 * (ancho / alto) ** -0.4);
---

<section class="equipo contenedor" aria-labelledby="equipo-titulo">
  <header class="equipo__cabecera">
    <h2 class="display t-banner" id="equipo-titulo">Nuestro <span class="acento">equipo</span></h2>
    <p>Poco a poco hemos construido un equipo de expertos que hacen estos proyectos posibles.</p>
  </header>

  <ul class="equipo__grilla" role="list">
    {
      equipo.map((persona) => {
        const { empresa } = persona;
        const contacto = !empresa && Boolean(persona.correo || persona.telefono);
        const mascara = `--foto: url(${persona.foto})`;
        return (
          <li
            class:list={['persona', { 'persona--capa': empresa || contacto }]}
            tabindex={contacto ? 0 : undefined}
            style={mascara}
          >
            <div class="persona__giro">
              <img class="persona__foto" src={persona.foto} alt={persona.nombre} width="389" height="488" loading="lazy" />
              <div class="persona__texto">
                <p class="persona__nombre display t-h4">{persona.nombre}</p>
                {empresa && <p class="persona__empresa">{empresa.nombre}</p>}
                <p>{persona.cargo}</p>
              </div>
              {empresa && (
                <a class="persona__capa" href={empresa.sitio} target="_blank" rel="noopener">
                  <img
                    class="persona__logo"
                    src={empresa.logo.src}
                    alt={empresa.nombre}
                    width={empresa.logo.ancho}
                    height={empresa.logo.alto}
                    loading="lazy"
                    style={`--alto: ${altoLogo(empresa.logo)}`}
                  />
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                </a>
              )}
              {contacto && (
                <div class="persona__capa persona__capa--contacto">
                  {persona.correo && (
                    <a class="persona__correo display" href={`mailto:${persona.correo}`}>
                      {persona.correo}
                    </a>
                  )}
                  {persona.telefono && (
                    <a
                      href={`https://wa.me/${persona.telefono.replace(/\D/g, '')}`}
                      target="_blank"
                      rel="noopener"
                      data-pixel="Contact"
                      data-pixel-nombre="whatsapp_equipo"
                    >
                      {persona.telefono}
                      <span class="sr-only">(WhatsApp, se abre en una pestaña nueva)</span>
                    </a>
                  )}
                </div>
              )}
              <span class="persona__brillo" aria-hidden="true" />
            </div>
          </li>
        );
      })
    }
  </ul>
</section>

<script>
  /* El efecto «cromo» (el del FlipCard de React Bits, sin darse vuelta): con
     el mouse encima la tarjeta crece un poco, se inclina hacia el puntero y
     una luz blanca lo sigue por encima de la foto y de la capa morada. Cada
     valor lo lleva un resorte, así el movimiento tiene inercia y al salir se
     asienta solo. No corre con el dedo ni si la persona pidió menos
     movimiento. */
  const INCLINACION = 12; // grados, con el puntero en el borde
  const ALZA = 1.03;
  const PERSPECTIVA = 1100;
  const GIRO = { rigidez: 240, amortiguacion: 24, masa: 0.6 };
  const SUAVE = { rigidez: 320, amortiguacion: 26, masa: 1 };
  const PASO = 1 / 120;
  const menosMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)');

  type Resorte = { valor: number; velocidad: number; meta: number } & typeof GIRO;

  const resorte = (valor: number, ajuste: typeof GIRO): Resorte => ({ valor, velocidad: 0, meta: valor, ...ajuste });

  /* Avanza `dt` segundos en pasos cortos (si un cuadro tarda, no se dispara)
     y dice si todavía se mueve. */
  const avanzar = (r: Resorte, dt: number) => {
    for (let quedan = dt; quedan > 0; quedan -= PASO) {
      const h = Math.min(quedan, PASO);
      const fuerza = -r.rigidez * (r.valor - r.meta) - r.amortiguacion * r.velocidad;
      r.velocidad += (fuerza / r.masa) * h;
      r.valor += r.velocidad * h;
    }
    if (Math.abs(r.velocidad) > 0.01 || Math.abs(r.valor - r.meta) > 0.001) return true;
    r.valor = r.meta;
    r.velocidad = 0;
    return false;
  };

  const limitar = (v: number) => Math.min(1, Math.max(0, v));

  for (const tarjeta of document.querySelectorAll<HTMLElement>('.persona')) {
    const giro = tarjeta.querySelector<HTMLElement>('.persona__giro');
    const brillo = tarjeta.querySelector<HTMLElement>('.persona__brillo');
    if (!giro || !brillo) continue;

    const x = resorte(0, GIRO);
    const y = resorte(0, GIRO);
    const alza = resorte(1, SUAVE);
    const luz = resorte(0, SUAVE);
    let cuadro = 0;
    let antes = 0;

    /* En reposo queda sin transformación, para que el texto se vea nítido.
       Mientras se mueve va por encima de las vecinas: inclinada hacia una
       esquina casi las toca. */
    const pintar = () => {
      const quieta = alza.valor === 1 && x.valor === 0 && y.valor === 0;
      giro.style.transform = quieta
        ? ''
        : `perspective(${PERSPECTIVA}px) scale(${alza.valor}) rotateX(${x.valor}deg) rotateY(${y.valor}deg)`;
      tarjeta.style.zIndex = quieta ? '' : '1';
      brillo.style.opacity = String(luz.valor);
    };

    const paso = (ahora: number) => {
      const dt = Math.min(Math.max(ahora - antes, 0), 100) / 1000;
      antes = ahora;
      let sigue = false;
      for (const r of [x, y, alza, luz]) sigue = avanzar(r, dt) || sigue;
      pintar();
      cuadro = sigue ? requestAnimationFrame(paso) : 0;
    };

    const animar = () => {
      if (cuadro) return;
      antes = performance.now();
      cuadro = requestAnimationFrame(paso);
    };

    const conMouse = (e: PointerEvent) => e.pointerType !== 'touch' && !menosMovimiento.matches;

    tarjeta.addEventListener('pointerenter', (e) => {
      if (!conMouse(e)) return;
      alza.meta = ALZA;
      animar();
    });

    /* Se mide contra el <li>, que no se mueve: la tarjeta de adentro sí. */
    tarjeta.addEventListener('pointermove', (e) => {
      if (!conMouse(e)) return;
      const caja = tarjeta.getBoundingClientRect();
      const px = limitar((e.clientX - caja.left) / caja.width);
      const py = limitar((e.clientY - caja.top) / caja.height);
      x.meta = (0.5 - py) * 2 * INCLINACION;
      y.meta = (px - 0.5) * 2 * INCLINACION;
      alza.meta = ALZA;
      luz.meta = 1;
      brillo.style.setProperty('--brillo-x', `${px * 100}%`);
      brillo.style.setProperty('--brillo-y', `${py * 100}%`);
      animar();
    });

    tarjeta.addEventListener('pointerleave', () => {
      x.meta = 0;
      y.meta = 0;
      alza.meta = 1;
      luz.meta = 0;
      animar();
    });
  }
</script>

<style>
  .equipo {
    margin-top: 96px;
  }

  .equipo__cabecera {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    color: var(--brand-500);
    text-align: center;
  }

  .equipo__grilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 32px 20px;
    margin-top: 48px;
  }

  .persona {
    position: relative;
    aspect-ratio: 387 / 486;
    container-type: inline-size;
    color: var(--neutral-100);
  }

  /* Lo que se inclina con el efecto «cromo»: el <li> queda quieto debajo,
     así el mouse no se le escapa por el borde mientras la tarjeta se mueve. */
  .persona__giro {
    position: absolute;
    inset: 0;
  }

  /* El WebP trae 1 px de margen por el trazo: 389 × 488. La capa morada y el
     brillo ocupan lo mismo para que la máscara calce con la foto. */
  .persona__foto,
  .persona__capa,
  .persona__brillo {
    position: absolute;
    top: -0.21%;
    left: -0.26%;
    width: 100.52%;
    max-width: none;
    height: 100.41%;
  }

  /* 394 / 486 = 81.07 %; 27 / 387 = 6.98 %. */
  .persona__texto {
    position: absolute;
    top: 81.07%;
    left: 6.98%;
    right: 24%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    filter: drop-shadow(0 0 6px rgba(31, 38, 43, 0.6));
    transition: opacity 0.25s ease;
  }

  .persona__texto p {
    margin: 0;
  }

  /* Nombre y empresa van pegados; el cargo, 4 más abajo. */
  .persona__texto .persona__empresa {
    margin-top: -4px;
    font-weight: 700;
  }

  /* «Frame 66»: brand/300 al 75 % sobre la foto. El morado va en ::before,
     recortado con la foto misma; si la máscara fuera de la capa también se
     comería el contorno del foco. */
  .persona__capa {
    isolation: isolate;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding-inline: 6.98%;
    color: inherit;
    text-align: center;
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .persona__capa::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(95, 36, 159, 0.75);
    -webkit-mask: var(--foto) center / 100% 100% no-repeat;
    mask: var(--foto) center / 100% 100% no-repeat;
  }

  /* La de contacto además se va con `visibility`, para que escondida no se
     puedan tocar el correo o el teléfono sin verlos. */
  .persona__capa--contacto {
    visibility: hidden;
    transition:
      opacity 0.25s ease,
      visibility 0s linear 0.25s;
  }

  .persona__capa--contacto a {
    color: inherit;
    text-decoration: none;
  }

  .persona__capa--contacto a:hover {
    text-decoration: underline;
  }

  /* La luz del efecto «cromo», también recortada con la foto. Dónde está y
     cuánto se ve lo pone el script. Al centro 0,3 (el original usa 0,22 sobre
     gris oscuro; sobre el morado casi no se notaba). */
  .persona__brillo {
    pointer-events: none;
    background: radial-gradient(
      circle farthest-side at var(--brillo-x, 50%) var(--brillo-y, 50%),
      rgba(255, 255, 255, 0.3) 0%,
      rgba(255, 255, 255, 0.228) 12%,
      rgba(255, 255, 255, 0.15) 26%,
      rgba(255, 255, 255, 0.084) 42%,
      rgba(255, 255, 255, 0.036) 60%,
      rgba(255, 255, 255, 0.012) 78%,
      rgba(255, 255, 255, 0) 100%
    );
    opacity: 0;
    -webkit-mask: var(--foto) center / 100% 100% no-repeat;
    mask: var(--foto) center / 100% 100% no-repeat;
  }

  .persona__logo {
    width: auto;
    height: calc(var(--alto) * 100cqw / 387);
  }

  /* Header 4 (24/30) en la tarjeta de 387; baja con ella para que
     «contabilidad@elexa.com.co» quepa en una línea. */
  .persona__correo {
    font-size: calc(24 * 100cqw / 387);
    line-height: calc(30 * 100cqw / 387);
    overflow-wrap: anywhere;
  }

  .persona--capa:is(:hover, :focus-visible, :has(:focus-visible)) .persona__capa {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s ease;
  }

  .persona--capa:is(:hover, :focus-visible, :has(:focus-visible)) .persona__texto {
    opacity: 0;
  }

  /* Sin mouse se abre al tocarla (la tarjeta toma el foco) y se cierra al
     tocar afuera. */
  @media (hover: none) {
    .persona--capa:focus-within .persona__capa {
      opacity: 1;
      visibility: visible;
      transition: opacity 0.25s ease;
    }

    .persona--capa:focus-within .persona__texto {
      opacity: 0;
    }
  }

  .persona--capa:focus-visible,
  .persona__capa:focus-visible {
    outline-offset: 6px;
  }

  /* Sobre «Sobre elexa», 64; el título a 24 del párrafo y las tarjetas a 46.
     Dos columnas a 12 entre sí. Los textos de la tarjeta se miden contra su
     ancho (cqw), con piso para la de 160 de un teléfono chico y techo en los
     24 y 16 del escritorio. Van a 6,5 % del borde de abajo (el texto del
     escritorio termina a 7,4 %) y hasta 16 % del derecho: la muesca de abajo
     empieza en el 83 % del ancho. */
  @media (max-width: 767px) {
    .equipo {
      margin-top: 64px;
    }

    .equipo__cabecera {
      gap: var(--space-lg);
    }

    /* Mobile/Header 1 (como .t-h1). */
    .equipo__cabecera h2 {
      font-size: min(48px, 12.3vw);
      line-height: 1.0834;
    }

    .equipo__grilla {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 12px;
      margin-top: 46px;
    }

    .persona__texto {
      top: auto;
      bottom: 6.5%;
      right: 16%;
      gap: 2px;
      font-size: clamp(11px, 7.2cqw, 16px);
      line-height: 1.3;
    }

    .persona__texto .persona__nombre {
      font-size: clamp(13px, 8.8cqw, 24px);
      line-height: 1.2;
    }

    .persona__texto .persona__empresa {
      margin-top: -2px;
    }

    .persona__capa {
      font-size: clamp(11px, 7.2cqw, 16px);
    }
  }

  @media (min-width: 1240px) {
    .equipo {
      margin-top: 204px;
    }

    .equipo__grilla {
      grid-template-columns: repeat(3, 387px);
      justify-content: space-between;
      gap: 56px 20px;
      margin-top: 90px;
    }
  }
</style>
