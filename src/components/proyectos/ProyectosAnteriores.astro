---
/* «Proyectos anteriores» — panel gris «Vector 1» (59:2654, 1397 × 1220) con
   una pestaña elevada en el centro, el título «Frame 78» (59:2655) y el mapa
   con su panel y las tarjetas (isla MapaProyectos.tsx).

   Los proyectos salen de la tabla `proyectos_anteriores` de Supabase (ver
   src/lib/anteriores.ts). Sin ninguno publicado, la sección no sale.

   El panel es el SVG del archivo estirado a 1220 de alto; las tarjetas se
   salen por debajo, como en el diseño. Entre 768 y 1240 px pasa a un
   rectángulo redondeado que envuelve todo.

   En el teléfono es «Vector 2» (303:4864, 366 × 1048), con una pestaña más
   baja, y envuelve sólo el título y el mapa: las tarjetas van debajo, sobre
   el blanco (ver la grilla en mapa.css). */
import MapaProyectos from './MapaProyectos';
import { getProyectosAnteriores } from '../../lib/anteriores';

const proyectos = await getProyectosAnteriores();
---

{
  proyectos.length > 0 && (
    <section class="anteriores" aria-labelledby="anteriores-titulo">
      <img class="anteriores__fondo" src="/img/mapa/fondo-anteriores.svg" alt="" width="1397" height="1220" />
      <img class="anteriores__fondo-movil" src="/img/mapa/fondo-anteriores-movil.svg" alt="" width="366" height="1048" />

      <header class="anteriores__cabecera">
        <h2 class="display t-h1" id="anteriores-titulo">
          Proyectos <span class="acento">anteriores</span>
        </h2>
        <p>
          Hemos trabajado en más de <strong>35 proyectos en Cali.</strong>{' '}
          <br />
          Desplazate en el mapa y haz click en el proyecto que quieres conocer.
        </p>
      </header>

      <MapaProyectos client:visible={{ rootMargin: '400px' }} proyectos={proyectos} />
    </section>
  )
}

<style>
  .anteriores {
    position: relative;
    isolation: isolate;
    width: var(--ancho-panel);
    margin: 96px auto 0;
    padding: 40px var(--space-md) var(--space-lg);
    border-radius: var(--radius-panel);
    background: var(--neutral-200);
  }

  .anteriores__fondo,
  .anteriores__fondo-movil {
    display: none;
  }

  .anteriores__cabecera {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 793px;
    margin: 0 auto 32px;
    color: var(--brand-500);
    text-align: center;
  }

  /* «Frame 33» (303:4865): a 17 del borde de arriba del panel, el título en
     Mobile/Header 2 partido en dos (254 de ancho) y el párrafo seguido, a 16. */
  @media (max-width: 767px) {
    .anteriores {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      margin-top: 84px;
      padding: 0;
      border-radius: 0;
      background: none;
    }

    /* Ocupa las filas del título y del mapa (en una grilla, un hijo absoluto
       con fila asignada se ubica respecto de ese tramo). */
    .anteriores__fondo-movil {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      grid-row: 1 / 3;
      grid-column: 1;
      width: 100%;
      max-width: none;
      height: 100%;
    }

    .anteriores__cabecera {
      grid-row: 1;
      grid-column: 1;
      gap: var(--space-md);
      margin: 17px var(--space-sm) 0;
    }

    .anteriores__cabecera h2 {
      max-width: 254px;
      margin-inline: auto;
      font-size: 30px;
      line-height: 34px;
    }

    .anteriores__cabecera br {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .anteriores {
      padding-inline: 0;
    }
  }

  @media (min-width: 1240px) {
    .anteriores {
      margin-top: 95px;
      padding: 55px 0 0;
      border-radius: 0;
      background: none;
    }

    .anteriores__fondo {
      display: block;
      position: absolute;
      top: 0;
      left: 0;
      z-index: -1;
      width: 100%;
      max-width: none;
      height: 1220px;
    }

    /* El mapa arranca a 220 del borde de arriba del panel. */
    .anteriores__cabecera {
      margin-bottom: 39px;
    }
  }
</style>
