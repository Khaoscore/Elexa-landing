---
/* Pie de /comerciales: el del sitio simplificado y sin la marca Elexa.
   Arriba el nombre de la página con una bajada y, al lado, la invitación a
   compartir la lista; debajo, la misma línea legal del pie de Elexa
   (derechos, «Powered by» y los documentos legales), que se deja a
   propósito. Mismo fondo (palette/ink/400) y mismo divisor en color/accent.

   Sin contacto: los asesores son varios e independientes (ver
   src/data/comerciales.ts). Antes iba «Escríbenos por WhatsApp». */
import Compartir from '../Compartir.astro';
import { POWERED_BY } from '../../data/site';
import { COMERCIALES_NOMBRE, COMERCIALES_URL, COMPARTIR_LISTA } from '../../data/comerciales';
import { documentosLegales } from '../../lib/legal';

interface Props {
  /** Distancia con lo de arriba en escritorio y en el teléfono. */
  separacion?: number;
  separacionMovil?: number;
}

const { separacion = 120, separacionMovil = 64 } = Astro.props;
const anio = new Date().getFullYear();
---

<footer class="pie-c" style={`--separacion:${separacion}px;--separacion-movil:${separacionMovil}px`}>
  <div class="pie-c__arriba">
    <div class="pie-c__marca">
      <a class="pie-c__nombre" href={COMERCIALES_URL}>
        <span class="pie-c__icono" aria-hidden="true">
          <img src="/img/comerciales/local.svg" alt="" width="24" height="24" />
        </span>
        <span class="display">{COMERCIALES_NOMBRE}</span>
      </a>
      <p>
        Locales, terrazas y espacios comerciales para arrendar en Cali, en ubicaciones estratégicas para comercio,
        oficinas y operación.
      </p>
    </div>

    <div class="pie-c__compartir">
      <p class="pie-c__titulo">¿Conoces a alguien que busca local?</p>
      <p class="pie-c__texto">
        Compártele la lista de espacios disponibles: siempre muestra los que se pueden alquilar hoy.
      </p>
      <Compartir {...COMPARTIR_LISTA}>
        <button type="button" class="btn btn--primario" data-abrir-compartir aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
            <path
              fill="currentColor"
              d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
            ></path>
          </svg>
          Compartir espacios
        </button>
      </Compartir>
    </div>
  </div>

  <hr class="pie-c__divisor" />

  <div class="pie-c__legal">
    <p>© {anio} Elexa. Todos los derechos reservados.</p>
    <p class="pie-c__creditos">
      Powered by <a href={POWERED_BY.href} target="_blank" rel="noopener">{POWERED_BY.label}</a>
    </p>
    <ul role="list">
      {
        documentosLegales.map((doc) => (
          <li>
            <a href={doc.href}>{doc.titulo}</a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>

<style>
  /* ---------- Teléfono ---------- */
  .pie-c {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-top: var(--separacion-movil);
    padding: 56px var(--margen) var(--space-xl);
    background: var(--ink-400);
    color: var(--neutral-100);
  }

  .pie-c__arriba {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .pie-c__marca,
  .pie-c__compartir {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .pie-c__nombre {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: fit-content;
    font-size: 22px;
    line-height: 26px;
    text-decoration: none;
  }

  .pie-c__icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    background: var(--brand-300);
  }

  .pie-c__marca p,
  .pie-c__texto {
    font-size: 14px;
    line-height: 20px;
    opacity: 0.7;
  }

  .pie-c__titulo {
    font-weight: 700;
    font-size: 18px;
    line-height: 24px;
  }

  .pie-c__compartir .btn {
    align-self: flex-start;
    margin-top: var(--space-xs);
    font-size: 18px;
  }

  .pie-c__divisor {
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--accent-300);
  }

  /* La línea legal del pie de Elexa: Roboto Condensed, centrada en el
     teléfono; en fila desde 768. */
  .pie-c__legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-note);
    font-size: 14px;
    line-height: normal;
    text-align: center;
  }

  .pie-c__legal p,
  .pie-c__legal li {
    opacity: 0.7;
  }

  .pie-c__legal a {
    text-decoration: none;
  }
  .pie-c__legal a:hover {
    text-decoration: underline;
  }

  .pie-c__creditos {
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pie-c__legal ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs) var(--space-lg);
  }

  /* ---------- Tablet ---------- */
  @media (min-width: 768px) {
    .pie-c {
      gap: var(--space-2xl);
      margin-top: min(var(--separacion), 96px);
      padding: 64px var(--margen) var(--space-2xl);
    }

    .pie-c__arriba {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-2xl);
    }

    .pie-c__marca {
      max-width: 480px;
    }

    .pie-c__compartir {
      max-width: 400px;
    }

    .pie-c__marca p,
    .pie-c__texto {
      font-size: 16px;
      line-height: 24px;
    }

    .pie-c__legal {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      font-size: 12px;
      text-align: start;
    }

    .pie-c__legal .pie-c__creditos {
      order: 1;
      flex-basis: 100%;
    }
  }

  /* Desde 1024 los tres en una fila, con el crédito en el centro. */
  @media (min-width: 1024px) {
    .pie-c__legal {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }

    .pie-c__legal .pie-c__creditos {
      order: 0;
    }

    .pie-c__legal ul {
      justify-self: end;
    }
  }

  @media (min-width: 1240px) {
    .pie-c {
      margin-top: var(--separacion);
      padding: var(--space-section) 120px var(--space-2xl);
    }

    .pie-c__arriba,
    .pie-c__divisor,
    .pie-c__legal {
      width: min(var(--contenido), 100%);
      margin-inline: auto;
    }
  }
</style>
