---
/* «Compartir» e «Información general», debajo de los botones de la tarjeta
   de la ficha de un espacio.

   · Compartir: la ventana de src/components/Compartir.astro, con la
     dirección pública de la ficha, que trae la foto de portada en la vista
     previa. Evento del pixel: CompartirEspacio.
   · Información general: abre en otra pestaña la carpeta de Drive del
     espacio (la columna Carpeta de la hoja; ver src/lib/espacios.ts). En el
     computador Drive ofrece «Descargar todo» (un .zip); en el teléfono se
     bajan los archivos uno por uno. Sin carpeta, el botón no sale. Antes se
     llamaba «Descargar carpeta»: el evento del pixel sigue siendo
     DescargarCarpeta para no partir los reportes de Meta.

   Los dos eventos son propios y no cuentan como contacto (ver
   MetaPixel.astro).

   En /comerciales no hay «Me interesa este espacio» (el asesor comparte la
   ficha, no escribe): ahí Compartir pasa a ser el botón principal, arriba de
   «Ver más espacios», e «Información general» queda solo debajo. Por eso la
   ficha lo pone en dos partes (`parte`):
   · extras     las dos píldoras (/espacios);
   · principal  sólo Compartir, como botón morado: «Compartir este espacio»;
   · carpeta    sólo «Información general».
   Lo que venga en el slot (el «Seleccionar» de /comerciales) va primero en
   la fila de las píldoras. */
import Compartir from '../Compartir.astro';

interface Props {
  nombre: string;
  barrio: string;
  /** La dirección pública de la ficha (https://www.elexa.com.co/espacios/…). */
  url: string;
  /** La carpeta de Drive del espacio. Vacío = sin «Información general». */
  carpeta: string;
  /** /comerciales: el mensaje al compartir no nombra a Elexa y el pixel lo
      cuenta en la categoría «comerciales». */
  sinMarca?: boolean;
  /** Qué botones van (ver arriba). Por defecto, las dos píldoras. */
  parte?: 'extras' | 'principal' | 'carpeta';
}

const { nombre, barrio, url, carpeta, sinMarca = false, parte = 'extras' } = Astro.props;

const texto = `Mira este espacio en alquiler${sinMarca ? '' : ' de Elexa'}: ${nombre}${barrio ? `, ${barrio}` : ''}.`;
const categoria = sinMarca ? 'comerciales' : 'espacios';

const conCompartir = parte !== 'carpeta';
const principal = parte === 'principal';
const conCarpeta = parte !== 'principal' && Boolean(carpeta);
const conSlot = parte !== 'principal' && Astro.slots.has('default');
---

{
  (conCompartir || conCarpeta || conSlot) && (
    <div class="extras">
      {conSlot && <slot />}
      {
        conCompartir && (
          <Compartir titulo={nombre} detalle={barrio} url={url} texto={texto} evento="CompartirEspacio" categoria={categoria}>
            <button
              type="button"
              class:list={['btn', principal ? 'btn--primario' : 'btn--pildora', 'extras__boton']}
              data-abrir-compartir
              aria-haspopup="dialog"
            >
              <svg viewBox="0 0 24 24" width={principal ? 20 : 24} height={principal ? 20 : 24} aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
                ></path>
              </svg>
              {principal ? 'Compartir este espacio' : 'Compartir'}
            </button>
          </Compartir>
        )
      }

      {
        conCarpeta && (
          <a
            class="btn btn--pildora extras__boton"
            href={carpeta}
            target="_blank"
            rel="noopener"
            data-pixel="DescargarCarpeta"
            data-pixel-propio
            data-pixel-nombre="carpeta_espacio"
            data-pixel-categoria={categoria}
          >
            <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
              <path
                fill="currentColor"
                d="M11 7h2v2h-2zm0 4h2v6h-2zm1-9C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z"
              />
            </svg>
            Información general
          </a>
        )
      }
    </div>
  )
}

<style>
  /* ---------- Las píldoras ----------
     Las blancas de global.css (.btn--pildora), del alto de los botones de
     arriba («Me interesa este espacio», «Ver más espacios»). Van lado a lado
     cuando caben; si no, cada una ocupa su renglón a lo ancho. En
     /comerciales, Compartir es el botón principal, a lo ancho como «Me
     interesa este espacio» en /espacios. */
  .extras {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .extras > :global(*),
  .extras__boton {
    flex: 1 1 auto;
  }
  .extras__boton svg {
    flex: none;
  }
</style>
