---
/* «Construimos valor, juntos.» — «Frame 47» (45:1141), 1200 × 690.
   Título e imagen a la izquierda (488), tres tarjetas a la derecha (590).

   Cada tarjeta es el marco gris del archivo («Vector 2», 12:547: 589 × 202,
   sólo trazo, con muescas arriba a la izquierda y abajo a la derecha), el
   círculo morado con «corporate_fare» en la muesca de arriba y la cajita con
   la flecha «east» en la de abajo. El marco tiene tamaño fijo, así que bajo
   700 px —donde ya no entra— se cambia por un borde redondeado común.

   La imagen de la izquierda es el marcador de posición (cuadriculado) que
   trae el diseño: reemplazar public/img/valor/imagen.png por la foto real. */
const pilares = [
  {
    titulo: 'Desarrolladores, no intermediarios.',
    cuerpo: 'Originamos, estructuramos, desarrollamos y operamos cada proyecto. ',
    destacado: 'Ganamos cuando el proyecto gana.',
  },
  {
    titulo: 'Acceso a lo que antes no alcanzaba.',
    cuerpo: 'Con el capital de un apartamento, ',
    destacado: 'participación en',
    cierre: ' bodegas, locales, oficinas y rentas cortas.',
  },
  {
    titulo: 'Cali por convicción.',
    cuerpo: 'No queremos ser los más grandes ni salir de la ciudad. Queremos conocer este mercado ',
    destacado: 'mejor que nadie.',
  },
];
---

<section class="valor contenedor" aria-labelledby="valor-titulo">
  <div class="valor__intro">
    <h2 class="display t-h1" id="valor-titulo">Construimos valor, <span class="acento">juntos.</span></h2>
    <img class="valor__imagen" src="/img/valor/imagen.png" alt="" width="488" height="534" loading="lazy" />
  </div>

  <ul class="valor__pilares" role="list">
    {
      pilares.map((pilar) => (
        <li class="pilar">
          <img class="pilar__marco" src="/img/valor/marco-tarjeta.svg" alt="" width="591" height="204" />
          <span class="pilar__icono" aria-hidden="true">
            <img src="/img/iconos/corporate-fare.svg" alt="" width="40" height="40" />
          </span>
          <h3 class="pilar__titulo display t-h3">{pilar.titulo}</h3>
          <p class="pilar__cuerpo">
            {pilar.cuerpo}
            <strong>{pilar.destacado}</strong>
            {pilar.cierre}
          </p>
          <span class="pilar__flecha" aria-hidden="true">
            <img src="/img/iconos/east.svg" alt="" width="52.59" height="23.17" />
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .valor {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
    margin-top: 96px;
  }

  .valor__intro {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  h2 {
    color: var(--brand-500);
  }

  .valor__imagen {
    width: 100%;
    max-width: 488px;
    height: auto;
    aspect-ratio: 488 / 534;
    object-fit: cover;
    border-radius: var(--radius-panel);
  }

  .valor__pilares {
    display: flex;
    flex-direction: column;
    gap: 42px;
  }

  /* ---------- Tarjeta: versión de borde común (móvil) ---------- */
  .pilar {
    position: relative;
    display: grid;
    grid-template-columns: 74px 1fr;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-md) var(--space-md) 64px;
    border: 2px solid var(--neutral-300);
    border-radius: var(--radius-card);
    color: var(--ink-500);
  }

  .pilar__marco {
    display: none;
  }

  .pilar__icono {
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    border-radius: var(--radius-full);
    background: var(--brand-300);
  }

  .pilar__cuerpo {
    grid-column: 1 / -1;
  }

  .pilar__flecha {
    position: absolute;
    right: -2px;
    bottom: -2px;
    display: grid;
    place-items: center;
    width: 81px;
    height: 40px;
    border: 2px solid var(--neutral-300);
    border-radius: var(--radius-card);
  }

  /* ---------- Tarjeta con el marco del diseño ---------- */
  @media (min-width: 700px) {
    .pilar {
      display: block;
      width: 590px;
      height: 202px;
      padding: 0;
      border: 0;
      border-radius: 0;
    }

    .pilar__marco {
      display: block;
      position: absolute;
      top: -1px;
      left: 0;
      max-width: none;
    }

    .pilar__icono {
      position: absolute;
      top: 0;
      left: 0;
    }

    .pilar__titulo {
      position: absolute;
      top: 19px;
      left: 119px;
      width: 443px;
      min-height: 67px;
      display: flex;
      align-items: center;
    }

    .pilar__cuerpo {
      position: absolute;
      top: 126px;
      left: 31px;
      width: 414px;
    }

    .pilar__flecha {
      top: 162px;
      left: 508px;
      right: auto;
      bottom: auto;
    }
  }

  @media (min-width: 1240px) {
    .valor {
      flex-direction: row;
      align-items: center;
      gap: 122px;
      margin-top: 181px;
    }

    .valor__intro {
      flex: 0 0 488px;
    }

    .valor__imagen {
      height: 534px;
    }

    .pilar__titulo {
      font-size: 36px;
      line-height: 38px;
    }
  }
</style>
