---
/* Tarjeta de un espacio en alquiler — «Group 1» / «Group 2» de los frames
   48:1969, 48:1990 y 48:2011: 590 × 669.5.

   Medidas del trazado del vector 48:1971:
   · arriba a la izquierda el diseño tenía una muesca con un carrito en un
     círculo magenta: Elexa pidió quitarlos y dejar la esquina entera;
   · muesca de abajo de 121.76 × 63.42 con la cajita de la flecha (96.92 ×
     45.47, borde de 2 en neutral/300), pegada a la esquina;
   · degradado de palette/ink/500 de transparente (22 %) a opaco (91 %), al
     30 %, sobre la foto;
   · texto a 37.56 del borde izquierdo: título y zona en Header 4, dirección
     en Body regular entre los dos.

   En el teléfono es «Group 1» / «Group 2» (303:5027, 303:5037), 342 × 388:
   exactamente esta tarjeta al 58 % (342 / 590), con las esquinas de 9.28 y
   el trazo de 1.16. Por eso la foto con su muesca y la cajita de la flecha
   se dibujan a tamaño de escritorio y se achican con
   `scale` (las muescas de formas.ts tienen el radio fijo en 16). El texto no
   se achica: va en los estilos móviles (Header 3 24/28, Body 16/20 y
   Header 4 20/24), a 22 del borde izquierdo y a 20 del de abajo.

   Toda la tarjeta es un enlace a la ficha del espacio. Con los datos de la
   hoja: el nombre arriba, el área y el valor en la línea chica, y el barrio
   abajo. La foto es la primera de la lista; sin fotos va el símbolo de Elexa
   sobre el fondo oscuro. Su texto alternativo va vacío: el nombre ya es el
   texto del enlace. Al pasar el mouse (o con el foco del teclado) crece toda
   la tarjeta, y la foto un poco más adentro. */
import type { Espacio } from '../../lib/espacios';
import { estiloMuescas } from '../../lib/formas';
import { ESPACIOS_URL } from '../../data/site';

interface Props {
  espacio: Espacio;
  /** En la primera fila de la grilla: su foto se pide de entrada, sin
      esperar a que el navegador calcule que está en pantalla. */
  arriba?: boolean;
  /** Dónde vive la ficha: /espacios, o /comerciales en la versión sin
      marca. */
  base?: string;
  /** Sin foto, una tienda en vez del símbolo de Elexa (/comerciales). */
  sinMarca?: boolean;
}

const { espacio, arriba = false, base = ESPACIOS_URL, sinMarca = false } = Astro.props;
const [portada] = espacio.fotos;
const valor = [espacio.precio, espacio.precioNota].filter(Boolean).join(' ');
const resumen = [espacio.area, valor].filter(Boolean).join(' · ');

const forma = Object.entries(
  estiloMuescas([{ esquina: 'br', ancho: 121.76, alto: 63.42 }]),
)
  .map(([propiedad, valor]) => `${propiedad}:${valor}`)
  .join(';');
---

<a class="espacio" href={`${base}/${espacio.slug}`} data-cursor="ver">
  <span class="espacio__marco muescas" style={forma}>
    {
      portada ? (
        <img
          class="espacio__foto"
          src={portada.src}
          srcset={portada.srcset}
          sizes="(min-width: 1240px) 590px, (min-width: 768px) 50vw, 100vw"
          alt=""
          loading={arriba ? 'eager' : 'lazy'}
          fetchpriority={arriba ? 'high' : undefined}
          decoding="async"
          referrerpolicy="no-referrer"
        />
      ) : (
        <img
          class="espacio__sin-foto"
          src={sinMarca ? '/img/comerciales/local.svg' : '/img/marca/simbolo-claro.svg'}
          alt=""
          width="29.06"
          height="32"
        />
      )
    }
    <span class="espacio__velo muescas__trazo" aria-hidden="true"></span>
  </span>

  <span class="espacio__texto">
    <span class="espacio__titulo display t-h4">{espacio.nombre}</span>
    {resumen && <span class="espacio__resumen">{resumen}</span>}
    {espacio.barrio && <span class="espacio__barrio display t-h4">{espacio.barrio}</span>}
  </span>

  <span class="espacio__flecha" aria-hidden="true">
    <img src="/img/iconos/flecha-espacio.svg" alt="" width="58.92" height="15.33" />
  </span>
</a>

<style>
  .espacio {
    position: relative;
    display: block;
    height: 460px;
    color: var(--neutral-100);
    text-decoration: none;
  }

  /* Crece toda la tarjeta (con su texto y la flecha) y se pone encima de la
     vecina: entre columnas hay 20 y al 102.5 % se come 7 de cada lado. */
  @media (prefers-reduced-motion: no-preference) {
    .espacio {
      transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .espacio:hover,
    .espacio:focus-visible {
      z-index: 1;
      transform: scale(1.025);
    }
  }

  .espacio__marco {
    position: absolute;
    inset: 0;
    display: block;
    background: var(--ink-500);
  }

  .espacio__foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @media (prefers-reduced-motion: no-preference) {
    .espacio__foto {
      transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .espacio:hover .espacio__foto,
    .espacio:focus-visible .espacio__foto {
      transform: scale(1.04);
    }
  }

  .espacio__sin-foto {
    position: absolute;
    top: 40%;
    left: 50%;
    width: 96px;
    height: auto;
    opacity: 0.18;
    transform: translate(-50%, -50%);
  }

  .espacio__velo {
    background:
      var(--muescas-trazo),
      linear-gradient(180deg, rgba(15, 19, 22, 0) 22.12%, rgba(15, 19, 22, 0.3) 90.87%);
  }

  /* La línea del barrio va pegada al resumen; entre título y resumen, 12. */
  .espacio__texto {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: calc(63.42px + 12px);
    display: flex;
    flex-direction: column;
    filter: drop-shadow(0 0 6px rgba(31, 38, 43, 0.6));
  }

  .espacio__resumen {
    margin-top: 12px;
  }

  .espacio__flecha {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    width: 96.92px;
    height: 45.47px;
    padding: 8px 17px;
    border: 2px solid var(--neutral-300);
    border-radius: var(--radius-card);
    transition: border-color 0.2s ease;
  }
  .espacio__flecha img {
    width: 58.92px;
    max-width: none;
    height: auto;
  }
  .espacio:hover .espacio__flecha {
    border-color: var(--accent-300);
  }

  /* La tarjeta de escritorio al 58 %: misma proporción (590 × 669.5). */
  @media (max-width: 767px) {
    .espacio {
      --escala: 0.5797;
      height: auto;
      aspect-ratio: 590 / 669.5;
    }

    .espacio__marco {
      inset: 0 auto auto 0;
      width: calc(100% / var(--escala));
      height: calc(100% / var(--escala));
      transform: scale(var(--escala));
      transform-origin: 0 0;
    }

    .espacio__texto {
      right: 22px;
      bottom: 20px;
      left: 22px;
      filter: drop-shadow(0 0 3.48px rgba(31, 38, 43, 0.6));
    }

    .espacio__titulo {
      font-size: 24px;
      line-height: 28px;
    }

    .espacio__resumen {
      margin-top: 6.96px;
    }

    .espacio__flecha {
      transform: scale(var(--escala));
      transform-origin: 100% 100%;
    }
  }

  @media (min-width: 768px) {
    .espacio {
      height: 600px;
    }
  }

  @media (min-width: 1240px) {
    .espacio {
      height: 670px;
    }

    .espacio__texto {
      right: auto;
      bottom: 46px;
      left: 37.56px;
      width: min(381.62px, 100% - 37.56px - 121.76px - 16px);
    }
  }
</style>
