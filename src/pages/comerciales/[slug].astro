---
/* Ficha de un espacio sin la marca Elexa: /comerciales/{slug}. Es la ficha
   de /espacios/{slug} (FichaEspacio.astro) con la barra y el pie de
   /comerciales, y sin nada que nombre a Elexa en los textos, el mapa, el
   mensaje al compartir ni la vista previa del enlace.

   Sin «Me interesa este espacio» (WhatsApp): la página es para que el
   asesor la comparta, así que el botón principal de la tarjeta es «Compartir
   este espacio». Además, sólo acá:
   · «Agregar a mi selección» en la tarjeta (BotonSeleccion.astro);
   · «Material para compartir» entre la descripción y el mapa: copiar el
     texto, la ficha en PDF y la imagen para historias
     (MaterialCompartir.astro);
   · la hoja para imprimir o guardar como PDF (FichaImpresa.astro). */
export const prerender = false;

import BaseComerciales from '../../layouts/BaseComerciales.astro';
import FichaEspacio from '../../components/espacios/FichaEspacio.astro';
import BotonSeleccion from '../../components/comerciales/BotonSeleccion.astro';
import MaterialCompartir from '../../components/comerciales/MaterialCompartir.astro';
import FichaImpresa from '../../components/comerciales/FichaImpresa.astro';
import { claveDe, getEspacio } from '../../lib/espacios';
import { origenesDe } from '../../lib/origenes';
import { SITE_URL } from '../../data/site';
import { COMERCIALES_NOMBRE, COMERCIALES_URL } from '../../data/comerciales';

const { slug = '' } = Astro.params;
const encontrado = await getEspacio(slug);

if (encontrado && !encontrado.exacto) {
  return Astro.redirect(`${COMERCIALES_URL}/${encontrado.espacio.slug}`, 301);
}

const espacio = encontrado?.espacio ?? null;
const otros = encontrado?.otros ?? [];

if (!espacio) Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=600');

const url = espacio ? `${SITE_URL}${COMERCIALES_URL}/${espacio.slug}` : '';
const valor = espacio ? [espacio.precio, espacio.precioNota].filter(Boolean).join(' ') : '';
const descripcion = espacio
  ? [
      `${espacio.nombre}${espacio.barrio ? `, ${espacio.barrio}` : ''}.`,
      espacio.direccion && `${espacio.direccion}.`,
      espacio.area && `${espacio.area}.`,
      espacio.disponibilidad && `${espacio.disponibilidad}.`,
      valor && `${valor}.`,
      'Espacio comercial en alquiler.',
    ]
      .filter(Boolean)
      .join(' ')
  : 'El espacio que buscas ya no está disponible.';
---

<BaseComerciales
  title={espacio ? `${espacio.nombre} — ${COMERCIALES_NOMBRE}` : `Espacio no encontrado — ${COMERCIALES_NOMBRE}`}
  description={descripcion}
  path={`${COMERCIALES_URL}/${espacio?.slug ?? slug}`}
  imagen={espacio?.fotos[0]?.jpeg}
  conectar={origenesDe([espacio?.fotos[0]?.src])}
  separacionPie={144}
  separacionPieMovil={61}
>
  {
    espacio ? (
      <>
        <FichaEspacio espacio={espacio} otros={otros} base={COMERCIALES_URL} url={url} sinMarca>
          <BotonSeleccion slot="extras" clave={claveDe(espacio.id)} nombre={espacio.nombre} variante="pildora" />
          <MaterialCompartir slot="material" espacio={espacio} url={url} />
        </FichaEspacio>
        <FichaImpresa espacio={espacio} url={url} />
      </>
    ) : (
      <section class="no-encontrado contenedor">
        <h1 class="display t-h2">Este espacio ya no está disponible</h1>
        <p>Puede que ya se haya alquilado. Mira los que están disponibles ahora.</p>
        <a class="btn btn--primario" href={COMERCIALES_URL}>
          Ver espacios disponibles
        </a>
      </section>
    )
  }
</BaseComerciales>

<style>
  .no-encontrado {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-lg);
    margin-top: 64px;
    color: var(--brand-500);
    text-align: center;
  }
</style>
