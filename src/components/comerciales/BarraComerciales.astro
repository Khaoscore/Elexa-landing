---
/* Barra de /comerciales: la pastilla blanca de las páginas internas, pero
   sin el logo ni el menú de Elexa. A la izquierda el nombre de la página con
   una tienda en un círculo morado (lleva a /comerciales); a la derecha
   «Compartir espacios», que comparte la lista con todos los espacios
   (/comerciales), también desde la ficha de uno. Antes era «Escríbenos»
   (WhatsApp): /comerciales no lleva contactos (ver src/data/comerciales.ts).

   Mide lo mismo que la barra clara (80 de alto a 21 del borde en
   escritorio): la tarjeta de la ficha, que acompaña al bajar, y el salto a
   «Ubicación» cuentan con ese alto. En el teléfono es la pastilla de 56 y
   el botón queda sólo con el ícono. */
import Compartir from '../Compartir.astro';
import { COMERCIALES_NOMBRE, COMERCIALES_URL, COMPARTIR_LISTA } from '../../data/comerciales';
---

<div class="barra-comerciales">
  <header class="barra">
    <a class="barra__marca" href={COMERCIALES_URL}>
      <span class="barra__icono" aria-hidden="true">
        <img src="/img/comerciales/local.svg" alt="" width="24" height="24" />
      </span>
      <span class="barra__nombre display">{COMERCIALES_NOMBRE}</span>
    </a>

    <Compartir {...COMPARTIR_LISTA}>
      <button type="button" class="btn btn--primario barra__contacto" data-abrir-compartir aria-haspopup="dialog">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path
            fill="currentColor"
            d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"
          ></path>
        </svg>
        <span class="barra__contacto-texto">Compartir espacios</span>
      </button>
    </Compartir>
  </header>
</div>

<script>
  /* Como la barra clara: al empezar a bajar gana una sombra suave. */
  for (const barra of document.querySelectorAll<HTMLElement>('.barra')) {
    const actualizar = () => barra.classList.toggle('barra--flotante', window.scrollY > 0);
    window.addEventListener('scroll', actualizar, { passive: true });
    actualizar();
  }
</script>

<style>
  .barra-comerciales {
    position: sticky;
    top: var(--margen-panel);
    z-index: 50;
    width: calc(100% - 2 * var(--margen));
    margin: var(--margen-panel) auto 0;
  }

  .barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 56px;
    padding: 8px 8px 8px 12px;
    border-radius: var(--radius-full);
    background: var(--neutral-100);
    transition: box-shadow 0.3s ease;
  }

  .barra--flotante {
    box-shadow: 0 8px 32px rgba(15, 19, 22, 0.12);
  }

  .barra__marca {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
    color: var(--brand-500);
    text-decoration: none;
  }

  .barra__icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-full);
    background: var(--brand-300);
  }
  .barra__icono img {
    width: 20px;
    height: 20px;
  }

  .barra__nombre {
    overflow: hidden;
    font-size: 18px;
    line-height: 22px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* En el teléfono, el botón redondo con el ícono. */
  .barra__contacto {
    flex: none;
    width: 40px;
    min-height: 40px;
    padding: 0;
  }
  .barra__contacto-texto {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  @media (min-width: 480px) {
    .barra__contacto {
      width: auto;
      padding: 8px 20px;
      font-size: 16px;
    }
    .barra__contacto-texto {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }
  }

  @media (min-width: 768px) {
    .barra-comerciales {
      width: min(var(--contenido), 100% - 2 * var(--margen-panel));
    }

    .barra {
      min-height: 72px;
      padding: 12px 12px 12px 16px;
    }

    .barra__icono {
      width: 44px;
      height: 44px;
    }
    .barra__icono img {
      width: 24px;
      height: 24px;
    }

    .barra__nombre {
      font-size: 22px;
      line-height: 26px;
    }

    .barra__contacto {
      min-height: 48px;
      padding: 11px 23px;
      font-size: 20px;
    }
  }

  @media (min-width: 1240px) {
    .barra-comerciales {
      top: 21px;
      margin-top: 21px;
    }

    .barra {
      height: 80px;
      padding: 16px 16px 16px 24px;
    }
  }
</style>
